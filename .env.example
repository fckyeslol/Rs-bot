# Copia este archivo como ".env" y completa con tus datos de Twilio.
# (El SDK de Twilio no es obligatorio para responder el webhook, pero
#  estas variables sirven si más adelante quieres ENVIAR mensajes salientes.)

TWILIO_ACCOUNT_SID=tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui

# Número de WhatsApp de Twilio (sandbox o producción), formato E.164
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Puerto del servidor (Railway lo asigna automáticamente)
PORT=3000

# ─── LLM para respuestas con tono humano (RAG) ───
# Funciona con OpenAI o con DeepSeek (compatible con el mismo SDK).
#
# OPCIÓN A · OpenAI:
#   OPENAI_API_KEY=sk-tu_key_de_openai   (https://platform.openai.com/api-keys)
#   OPENAI_MODEL=gpt-4o-mini
#   (deja OPENAI_BASE_URL vacío)
#
# OPCIÓN B · DeepSeek (más económico):
#   OPENAI_API_KEY=sk-tu_key_de_deepseek (https://platform.deepseek.com)
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_MODEL=deepseek-v4-flash
#
# ⚠️ NO pongas aquí tu key real. Este archivo se sube a GitHub.
#    Tu key real va SOLO en el archivo .env (ignorado por git) o en
#    las Variables de Railway.
OPENAI_API_KEY=sk-tu_api_key_aqui
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.deepseek.com

# ─── Botón Bancolombia por APIs (confirmación de pagos) ───
# Estas credenciales las entrega Bancolombia al vincular tu comercio
# y darte acceso al sandbox (developer.bancolombia.com).
# Si las dejas vacías, la integración de pagos queda DESACTIVADA y el
# bot funciona normal.
# BANCOLOMBIA_CLIENT_ID=
# BANCOLOMBIA_CLIENT_SECRET=
# BANCOLOMBIA_TOKEN_URL=
# BANCOLOMBIA_API_URL=
# BANCOLOMBIA_WEBHOOK_SECRET=
# URL pública de tu bot (para urlRetorno / urlConfirmacion)
# PUBLIC_URL=https://rs-bot-production.up.railway.app
